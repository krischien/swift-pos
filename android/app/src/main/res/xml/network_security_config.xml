<?xml version="1.0" encoding="utf-8"?>
<!-- Allows cleartext (HTTP) for dev/testing with local API (e.g. http://192.168.x.x:4001).
     For production Play Store release with HTTPS API, you can remove this file
     and the networkSecurityConfig reference from AndroidManifest. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
