# Copy to android/keystore.properties (gitignored) after creating your release keystore.
#
# keytool -genkey -v -keystore swiftpos-release.keystore -alias swiftpos -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=../swiftpos-release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=swiftpos
keyPassword=YOUR_KEY_PASSWORD
