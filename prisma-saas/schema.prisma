// SaaS multi-tenant schema
// Dev: SQLite (SAAS_DATABASE_URL=file:./prisma-saas/saas-dev.db or omit to use default)
// Prod: PostgreSQL (SAAS_DATABASE_URL=postgresql://...)
// Run: npx prisma generate --schema=prisma-saas/schema.prisma
// Migrate: npx prisma migrate dev --schema=prisma-saas/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/saas-client"
}

datasource db {
  provider = "sqlite"
  url      = env("SAAS_DATABASE_URL")
}

model Organization {
  id               String    @id @default(cuid())
  name             String
  /// Denormalized: tindahan | negosyo | kumpanya | suspended
  plan             String    @default("tindahan")
  phone            String?
  email            String?
  address          String?
  stripeCustomerId String?
  billingDueDate   DateTime?
  trialEndsAt      DateTime?
  createdAt        DateTime  @default(now())

  users           User[]
  stores          Store[]
  notifications   OrganizationNotification[]
  billingPayments OrganizationBillingPayment[]
  subscription    OrganizationSubscription?
}

/// Org-level subscription (one per organization)
model OrganizationSubscription {
  id                   String    @id @default(cuid())
  organizationId       String    @unique
  /// tindahan | negosyo | kumpanya
  tier                 String    @default("tindahan")
  /// trialing | active | pending_payment | past_due | cancelled | expired
  status               String    @default("trialing")
  trialStart           DateTime?
  trialEnd             DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  monthlyPriceCentavos Int       @default(49900)
  setupFeePaid         Boolean   @default(false)
  /// Last plan chosen on /pricing while awaiting admin activation
  requestedTier        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationNotification {
  id             String    @id @default(cuid())
  organizationId String
  message        String
  type           String    @default("info") // "info" | "warning" | "urgent"
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationBillingPayment {
  id             String   @id @default(cuid())
  organizationId String
  /// Calendar month paid for, YYYY-MM
  period         String
  amountCents    Int?
  method         String?
  note           String?
  recordedById   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("BillingPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, period])
}

model Store {
  id                      String   @id @default(cuid())
  organizationId          String
  name                    String
  address                 String?
  receiptLogoUrl          String?
  /// "retail" | "fnb" — immutable after create (enforced in API)
  businessMode            String   @default("retail")
  enableCylinderTracking  Boolean  @default(false)
  collectCylinderDeposits Boolean  @default(true)
  createdAt               DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories      Category[]
  products        Product[]
  sales           Sale[]
  userAccess      UserStore[]
  ingredients     Ingredient[]
  menuCategories  MenuCategory[]
  menuItems       MenuItem[]
  cylinderLoans   CylinderLoan[]
  cylinderReturns CylinderReturn[]
  customers       Customer[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  email          String   @unique
  password       String
  role           String // "super_admin" | "owner" | "admin" | "cashier"
  createdAt      DateTime @default(now())

  organization            Organization?                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales                   Sale[]                       @relation("SaleCashier")
  voidedSales             Sale[]                       @relation("SaleVoidedBy")
  storeAccess             UserStore[]
  billingPaymentsRecorded OrganizationBillingPayment[] @relation("BillingPaymentRecordedBy")
  sukiCustomersAssigned   Customer[]                   @relation("CustomerSukiAssignedBy")
  cylinderReturns         CylinderReturn[]
}

model UserStore {
  userId  String
  storeId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
}

model Category {
  id      String @id @default(cuid())
  storeId String
  name    String

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]
}

model Product {
  id                String  @id @default(cuid())
  storeId           String
  name              String
  categoryId        String
  itemCode          String?
  sku               String?
  hasVariants       Boolean @default(false)
  basePrice         Float?
  price             Float?
  stock             Int?
  lowStockThreshold Int     @default(0)
  marginPercentage  Float?
  status            String  @default("active")
  image             String?
  barcode           String?
  qrCode            String?
  unitOfMeasure     String? @default("PCS")
  /// LPG/butane: track returnable canister obligations from sales
  tracksCylinder    Boolean @default(false)
  cylinderSize      String?
  depositAmount     Float   @default(0)
  emptyStock        Int     @default(0)

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants      Variant[]
  saleItems     SaleItem[]
  cylinderLoans CylinderLoan[]
}

model Variant {
  id        String @id @default(cuid())
  productId String
  name      String
  price     Float
  stock     Int

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]
}

model Sale {
  id                 String    @id @default(cuid())
  storeId            String
  ticketNumber       String?
  cashierId          String?
  cashierName        String
  total              Float
  depositAmount      Float     @default(0)
  amountDue          Float     @default(0)
  customerId         String?
  paymentMethod      String    @default("cash")
  amountReceived     Float
  change             Float
  status             String    @default("completed")
  gcashTransactionId String?
  voidedAt           DateTime?
  voidedById         String?
  voidedByName       String?
  createdAt          DateTime  @default(now())

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashier       User?          @relation("SaleCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  voidedBy      User?          @relation("SaleVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  items         SaleItem[]
  cylinderLoans CylinderLoan[]
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

/// Outstanding canister obligation created when a tracked product is sold (not exchange-only).
model CylinderLoan {
  id               String    @id @default(cuid())
  storeId          String
  saleId           String
  saleItemId       String?
  productId        String
  quantity         Int
  returnedQuantity Int       @default(0)
  customerId       String?
  customerName     String?
  customerPhone    String?
  depositAmount    Float     @default(0)
  depositRefunded  Boolean   @default(false)
  /// out | returned | written_off
  status           String    @default("out")
  outAt            DateTime  @default(now())
  returnedAt       DateTime?

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale     Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  returns  CylinderReturn[]

  @@index([storeId, status])
  @@index([saleId])
  @@index([customerId])
}

model Customer {
  id               String    @id @default(cuid())
  storeId          String
  name             String
  normalizedName   String
  phone            String?
  normalizedPhone  String?
  nickname         String?
  address          String?
  qrToken          String    @unique
  isSuki           Boolean   @default(false)
  sukiAssignedAt   DateTime?
  sukiAssignedById String?
  sukiNote         String?
  archived         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sukiAssignedBy User?          @relation("CustomerSukiAssignedBy", fields: [sukiAssignedById], references: [id], onDelete: SetNull)
  sales          Sale[]
  cylinderLoans  CylinderLoan[]

  @@index([storeId, normalizedName])
  @@index([storeId, normalizedPhone])
  @@index([storeId, archived])
}

model CylinderReturn {
  id           String   @id @default(cuid())
  loanId       String
  storeId      String
  quantity     Int
  refundAmount Float    @default(0)
  actorId      String?
  actorName    String?
  note         String?
  returnedAt   DateTime @default(now())

  loan  CylinderLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  store Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actor User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([loanId, returnedAt])
  @@index([storeId, returnedAt])
}

model Ingredient {
  id                String  @id @default(cuid())
  storeId           String
  name              String
  sku               String?
  barcode           String?
  stock             Int     @default(0)
  lowStockThreshold Int     @default(0)
  unitOfMeasure     String? @default("PCS")
  status            String  @default("active")

  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  recipeLines RecipeLine[]
}

model MenuCategory {
  id      String @id @default(cuid())
  storeId String
  name    String

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]
}

model MenuItem {
  id             String  @id @default(cuid())
  storeId        String
  menuCategoryId String
  name           String
  price          Float
  status         String  @default("active")
  image          String?
  barcode        String?

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  menuCategory MenuCategory @relation(fields: [menuCategoryId], references: [id], onDelete: Cascade)
  recipeLines  RecipeLine[]
  saleItems    SaleItem[]
}

model RecipeLine {
  id             String @id @default(cuid())
  menuItemId     String
  ingredientId   String
  quantity       Float
  wastagePercent Float?

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
}

model SaleItem {
  id                   String  @id @default(cuid())
  saleId               String
  productId            String?
  menuItemId           String?
  variantId            String?
  productName          String
  variantName          String?
  quantity             Int
  price                Float
  subtotal             Float
  broughtEmptyQuantity Int     @default(0)

  sale     Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  variant  Variant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
}
