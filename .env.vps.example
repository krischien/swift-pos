# SwiftPOS — private server / VPS production (57.129.115.42, swiftpos.backbone.ph)
#
# On the server after git pull:
#   cp .env.vps.example .env.vps
#   nano .env.vps   # fill JWT_SECRET, SAAS_DATABASE_URL, SUPER_ADMIN_EMAILS
#   npm run build:api
#   npx prisma migrate deploy --schema=prisma-saas/schema.pg.prisma
#
# Do NOT commit .env.vps (real secrets). This file is the template only.

NODE_ENV=production

# API port (open in firewall or reverse-proxy to HTTPS)
SAAS_PORT=4001

# PostgreSQL recommended for production (use schema.pg.prisma + build:api)
SAAS_DATABASE_URL=postgresql://user:password@localhost:5432/swift_pos_saas

# REQUIRED: random string, at least 32 characters. Server exits if missing/weak.
JWT_SECRET=replace-with-long-random-secret-min-32-chars

SUPER_ADMIN_EMAILS=your-admin@example.com

# REQUIRED in production — explicit origins only. Never use *.
# Web app + Capacitor mobile. Add your public site URL and API host if needed.
SAAS_CORS_ORIGINS=https://swiftpos.backbone.ph,capacitor://localhost,ionic://localhost

# Do NOT set RATE_LIMIT_DISABLED in production.

# Billing contact shown on payment instructions
BILLING_GCASH=0923 835 1690
BILLING_BANK=BDO — Account details on request
BILLING_CONTACT_PHONE=+63 923 835 1690
BILLING_CONTACT_EMAIL=hello@backbone.ph

# --- Frontend build (run on server or CI before serving dist/) ---
# VITE_APP_MODE=saas
# VITE_SAAS_API_URL=http://57.129.115.42:4001
# Or HTTPS: VITE_SAAS_API_URL=https://swiftpos.backbone.ph
