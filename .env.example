# Solo mode (default) - VITE_APP_MODE=solo or omit
# SaaS mode - VITE_APP_MODE=saas, use with build:saas

# Frontend (Solo uses local server, SaaS uses cloud API)
VITE_APP_MODE=saas
VITE_SAAS_API_URL=http://localhost:4001

# SaaS backend - SQLite for dev (no PostgreSQL needed), PostgreSQL for prod
# Dev (default): SQLite file
SAAS_DATABASE_URL=file:./prisma-saas/saas-dev.db
# Prod: PostgreSQL
# SAAS_DATABASE_URL=postgresql://user:password@localhost:5432/swift_pos_saas
JWT_SECRET=change-me-in-production-use-long-random-string
SUPER_ADMIN_EMAILS=admin@example.com
