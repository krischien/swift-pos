# =============================================================================
# LOCAL DEVELOPMENT — copy to `.env` (gitignored):  cp .env.example .env
# =============================================================================

VITE_APP_MODE=saas
VITE_SAAS_API_URL=http://localhost:4001

# SQLite only for `npm run dev:saas` (prisma-saas/schema.prisma)
SAAS_DATABASE_URL=file:./prisma-saas/saas-dev.db

JWT_SECRET=change-me-in-production-use-long-random-string-min-32-chars
SUPER_ADMIN_EMAILS=admin@example.com

# Relaxed CORS for local dev only (requires NODE_ENV=development below)
SAAS_CORS_ORIGINS=*

# Required for local API — do not use production on your laptop
NODE_ENV=development

# Optional: RATE_LIMIT_DISABLED=1 for E2E / hammering login in tests

# Billing contact (payment instructions UI)
BILLING_GCASH=0923 835 1690
BILLING_BANK=BDO — Account details on request
BILLING_CONTACT_PHONE=+63 923 835 1690
BILLING_CONTACT_EMAIL=hello@backbone.ph
# Optional price overrides (centavos)
# TINDAHAN_PRICE=49900
# NEGOSYO_PRICE=99900
# KUMPANYA_PRICE=199900
# SETUP_FEE=149900
# TRIAL_DAYS=7

# =============================================================================
# PRIVATE SERVER / VPS PRODUCTION — do NOT put these in `.env` on your laptop
# Template: `.env.vps.example` → on server: cp .env.vps.example .env.vps
# =============================================================================
#
# NODE_ENV=production
# SAAS_DATABASE_URL=postgresql://user:password@localhost:5432/swift_pos_saas
# JWT_SECRET=<64+ char random>
# SUPER_ADMIN_EMAILS=your-admin@example.com
# SAAS_CORS_ORIGINS=https://swiftpos.backbone.ph,capacitor://localhost,ionic://localhost
# VITE_SAAS_API_URL=http://57.129.115.42:4001
