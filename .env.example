# Solo mode (default) - VITE_APP_MODE=solo or omit
# SaaS mode - VITE_APP_MODE=saas, use with build:saas

# Frontend (Solo uses local server, SaaS uses cloud API)
VITE_APP_MODE=saas
VITE_SAAS_API_URL=http://localhost:4001

# SaaS backend — `npm run dev:saas` always uses SQLite (prisma-saas/schema.prisma).
# Use a file: URL here. Do not set postgresql:// for local dev or Prisma will error.
SAAS_DATABASE_URL=file:./prisma-saas/saas-dev.db
# Production (Vercel / Node with schema.pg.prisma + build:api) uses PostgreSQL instead — set on the host, not for dev:saas.
# SAAS_DATABASE_URL=postgresql://user:password@localhost:5432/swift_pos_saas
JWT_SECRET=change-me-in-production-use-long-random-string
SUPER_ADMIN_EMAILS=admin@example.com
