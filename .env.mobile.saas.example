# Mobile SaaS build - copy to .env.saas or set before build:mobile:saas
# REQUIRED on mobile: API must be an absolute URL (relative URLs return HTML and cause "unexpected token <" errors)
# - Local dev: use your machine's IP, e.g. http://192.168.1.100:4001 (phone and PC on same network)
# - Production: use HTTPS, e.g. https://your-api.example.com
VITE_APP_MODE=saas
VITE_SAAS_API_URL=http://YOUR_IP:4001
