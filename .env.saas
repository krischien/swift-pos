# SaaS build - use with: npm run build:saas
VITE_APP_MODE=saas
# Optional for demo: Android emulator uses 10.0.2.2:4001, iOS simulator uses localhost:4001 by default.
# Set for real device: your machine's IP so the phone can reach the API on the same network
VITE_SAAS_API_URL=http://192.168.1.7:4001
