# --- Client (Vite / web + Capacitor): only VITE_* vars are baked into the app bundle. ---
# The mobile app does NOT read SAAS_DATABASE_URL or connect to Postgres directly; it only calls VITE_SAAS_API_URL.
# Local dev (`vite --mode saas` / start:saas): API on this PC. Mobile APK: build:mobile:saas forces remote URL in package.json.
VITE_APP_MODE=saas
VITE_SAAS_API_URL=http://localhost:4001

# --- Server only — local SQLite for dev. Deployed API: set postgresql://... on the host. ---
SAAS_DATABASE_URL=file:./prisma-saas/saas-dev.db

# Auth
JWT_SECRET=ca723a266fe5d91a48a93079543a864a531d33c8dece73d6c8bcf4e4208b8cc8dfdb6b24e670a1c1f711ac1022b6cbe7c15fcddc498ea51991a62e4e07b46be7
SUPER_ADMIN_EMAILS=hubzero9@gmail.com

# CORS (comma-separated)
# Used when running the Node SaaS server locally. On 57.129.115.42, set SAAS_CORS_ORIGINS to include https://swiftpos.backbone.ph and capacitor://localhost for mobile.
SAAS_CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost,https://swiftpos.backbone.ph