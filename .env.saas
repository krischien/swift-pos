# Vite `--mode saas` / mobile build env (committed template — no secrets).
# Copy to `.env.saas.local` or set vars on the build machine; real JWT lives in `.env` / `.env.vps` on the server only.
#
# Private server production API + CORS: see `.env.vps.example`
# Local dev API: use root `.env` (gitignored) with NODE_ENV=development

VITE_APP_MODE=saas
# Local web dev (Vite proxy). Production/mobile: use your VPS URL (see package.json build:mobile:saas).
VITE_SAAS_API_URL=http://localhost:4001
