{
  "buildCommand": "npm run vercel:build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/server/saas/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "server/saas/index.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "{prisma-saas/generated/**,src/**}"
    }
  }
}
