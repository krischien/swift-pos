{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:saas:web": "vite --mode saas",
    "start:saas": "concurrently -n server,web -c blue,green \"npm run dev:saas\" \"npm run dev:saas:web\"",
    "start:saas:e2e": "concurrently -n server,web -c blue,green \"cross-env RATE_LIMIT_DISABLED=1 npm run dev:saas\" \"cross-env VITE_E2E=true npm run dev:saas:web\"",
    "e2e": "node scripts/e2e-run-with-summary.mjs --headed",
    "e2e:headless": "node scripts/e2e-run-with-summary.mjs",
    "e2e:ci": "concurrently -k -s first -n server,test \"npm run start:saas:e2e\" \"wait-on http://localhost:8080 http://localhost:4001/api/health -t 120000 && npm run e2e:headless\"",
    "security": "node scripts/security-run-with-summary.mjs",
    "security:ci": "concurrently -k -s first -n server,test \"npm run dev:saas\" \"wait-on http://localhost:4001/api/health -t 120000 && npm run security\"",
    "security:audit": "npm audit --audit-level=high",
    "api-test": "node scripts/api-run-with-summary.mjs",
    "api-test:ci": "concurrently -k -s first -n server,test \"npm run dev:saas\" \"wait-on http://localhost:4001/api/health -t 120000 && npm run api-test -- --no-wait\"",
    "api-test:smoke": "node scripts/api-run-with-summary.mjs --suite=smoke",
    "api-test:functional": "node scripts/api-run-with-summary.mjs --suite=functional",
    "api-test:integration": "node scripts/api-run-with-summary.mjs --suite=integration",
    "api-test:regression": "node scripts/api-run-with-summary.mjs --suite=regression",
    "api-test:fuzz": "node scripts/api-run-with-summary.mjs --suite=fuzz",
    "api-test:security": "npm run security",
    "api-test:load": "node api-tests/load/run.mjs",
    "api-test:stress": "node api-tests/stress/run.mjs",
    "test:all": "npm run api-test:regression && npm run security && npm run e2e:headless",
    "start:mobile": "npm run dev:saas",
    "build": "vite build",
    "build:solo": "vite build",
    "build:saas": "vite build --mode saas",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:server": "tsx server/index.ts",
    "dev:saas": "cross-env NODE_ENV=development tsx --env-file=.env server/saas/index.ts",
    "start:api:vps": "cross-env NODE_ENV=production tsx --env-file=.env.vps server/saas/index.ts",
    "dev:saas:sqlite": "npm run prisma:generate:saas && npm run dev:saas",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:saas": "prisma migrate dev --schema=prisma-saas/schema.prisma",
    "prisma:migrate:saas:dev": "prisma migrate dev --schema=prisma-saas/schema.dev.prisma",
    "prisma:push:saas:dev": "prisma db push --schema=prisma-saas/schema.dev.prisma",
    "prisma:generate:saas": "prisma generate --schema=prisma-saas/schema.prisma",
    "prisma:generate:saas:dev": "prisma generate --schema=prisma-saas/schema.dev.prisma",
    "saas:seed": "tsx --env-file=.env server/saas/seed.ts",
    "saas:seed-demo": "tsx --env-file=.env server/saas/seed-demo.ts",
    "saas:seed-second-org": "tsx --env-file=.env server/saas/scripts/seedSecondOrg.ts",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx server/seed.ts",
    "build:mobile:solo": "npm run build:solo && npx cap sync android",
    "build:mobile:saas": "cross-env VITE_APP_MODE=saas VITE_SAAS_API_URL=http://57.129.115.42:4001 vite build --mode saas && npx cap sync android",
    "build:mobile:saas:remote": "npm run build:mobile:saas",
    "build:mobile:saas:local": "cross-env VITE_APP_MODE=saas VITE_SAAS_API_URL=http://192.168.1.7:4001 vite build --mode saas && npx cap sync android",
    "build:mobile:saas:emulator": "cross-env VITE_APP_MODE=saas VITE_SAAS_API_URL=http://10.0.2.2:4001 vite build --mode saas && npx cap sync android",
    "build:mobile:saas:adb": "cross-env VITE_APP_MODE=saas VITE_SAAS_API_URL=http://localhost:4001 vite build --mode saas && npx cap sync android",
    "mobile:emulator:tunnel": "adb reverse tcp:4001 tcp:4001",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:sync:solo": "npm run build:solo && npx cap sync android",
    "cap:sync:saas": "npm run build:mobile:saas",
    "cap:open": "npx cap open android",
    "build:api": "npx prisma generate --schema=prisma-saas/schema.pg.prisma && npx esbuild server/saas/index.ts --bundle --platform=node --format=esm --outfile=api/index.js --packages=external",
    "vercel:build": "npm run build:saas && node scripts/prisma-generate-vercel.mjs && npm run build:api"
  },
