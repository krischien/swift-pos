# Vercel Environment Variables for Neon Database
# Add these in Vercel: Settings → Environment Variables
# Do NOT commit actual values to git.

# === Required for build & runtime ===

# Neon PostgreSQL - use pooled connection string (from neon.tech dashboard)
SAAS_DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# JWT secret (generate: openssl rand -hex 32)
JWT_SECRET=your-long-random-secret

# Super admin emails (comma-separated)
SUPER_ADMIN_EMAILS=admin@demo.com

# CORS origins (comma-separated). Add your Vercel URL after first deploy.
SAAS_CORS_ORIGINS=https://your-project.vercel.app,capacitor://localhost,ionic://localhost

# Frontend build - required for SaaS mode
VITE_APP_MODE=saas

# Optional: show Owner/Cashier demo quick-login on /login (omit or false to hide in production)
# VITE_QUICK_LOGIN_DEMO=true

# Leave empty for same-origin (web uses /api)
VITE_SAAS_API_URL=
